{
  "name": "soil-layouts",
  "description": "The claw-soil-predator configurations on different soil layouts: every configuration at 3 soil densities x 3 patch sizes, with each replicate on its own soil seed.",
  "ticks": 250000,
  "seeds": [1, 2, 3, 4, 5],
  "soilSeeds": [42, 7, 123, 2024, 99],
  "grid": {"cols": 384, "rows": 193, "cell_size": 5},
  "base": {
    "clawCellsFree": true,
    "hibernateWhileHidden": true,
    "stayHiddenNearPredator": true,
    "soilRegenRate": 0.05,
    "predatorMoveInterval": 3
  },
  "vary": {
    "soilPatchThreshold": [-0.1, 0, 0.1],
    "soilPatchResolution": [10, 20, 40]
  },
  "configs": [
    {"label": "baseline"},
    {"label": "claw-off", "set": {"clawCellsFree": false, "hibernateWhileHidden": false, "stayHiddenNearPredator": false}},
    {"label": "soil-slow", "set": {"soilRegenRate": 0.01}},
    {"label": "soil-fast", "set": {"soilRegenRate": 0.2}},
    {"label": "pred-2", "set": {"predatorMoveInterval": 2}},
    {"label": "pred-1", "set": {"predatorMoveInterval": 1}}
  ]
}
